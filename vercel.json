{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|svg|ico|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/work",
      "destination": "https://app.carolinapaintingmn.com/work"
    },
    {
      "source": "/work/:slug",
      "destination": "https://app.carolinapaintingmn.com/work/:slug"
    },
    {
      "source": "/work.json",
      "destination": "https://app.carolinapaintingmn.com/work.json"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://app.carolinapaintingmn.com/sitemap.xml"
    }
  ]
}
